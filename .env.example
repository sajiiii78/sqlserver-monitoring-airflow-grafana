# Copy to .env (it is git-ignored) - read by scripts/start_all.sh. Wrap every value in single quotes.
COMPOSE_DIR='/home/you/sqlserver-lab'                 # folder containing the docker-compose.yml (SQL Server + Grafana)
AIRFLOW_VENV='/home/you/airflow-venv/bin/activate'    # your Airflow virtualenv
SA_PASSWORD='change-me'                               # SA password of the SQL Server container (lab only)
MONITOR_PASSWORD='change-me-too'                      # password of the read-only sqlmon_reader login
# optional
# SQL_CONTAINER='sql_server_sales'
# COMPOSE_SERVICES='sql_server_sales grafana'
# EXTRA_CONTAINERS='postgres_sales mongodb_sales'
